rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isUser(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Connection ids are the two uids, sorted, joined with "_".
    function pairId(a, b) {
      return a < b ? a + '_' + b : b + '_' + a;
    }

    function connected(a, b) {
      let path = /databases/$(database)/documents/connections/$(pairId(a, b));
      return exists(path) && get(path).data.status == 'accepted';
    }

    function roleOf(uid) {
      return get(/databases/$(database)/documents/profiles/$(uid)).data.role;
    }

    function onlyChanges(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    function nonNegative(n) {
      return n is number && n >= 0;
    }

    // Public profile.
    match /profiles/{uid} {
      allow read: if true;
      allow create: if isUser(uid)
        && request.resource.data.uid == uid
        && request.resource.data.role in ['creator', 'brand']
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 80;
      allow update: if isUser(uid)
        && request.resource.data.uid == uid
        && request.resource.data.role == resource.data.role
        && request.resource.data.displayName.size() <= 80
        && request.resource.data.bio.size() <= 600;
    }

    // Private contact details: the owner, or someone with an accepted connection.
    match /contacts/{uid} {
      allow read: if isUser(uid) || (signedIn() && connected(uid, request.auth.uid));
      allow write: if isUser(uid);
    }

    // One connect request per pair of users, always between a creator and a brand.
    match /connections/{id} {
      allow get: if signedIn() && request.auth.uid in id.split('_');
      allow list: if signedIn() && request.auth.uid in resource.data.participants;
      allow create: if signedIn()
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.toUid != request.auth.uid
        && id == pairId(request.resource.data.fromUid, request.resource.data.toUid)
        && request.resource.data.participants == id.split('_')
        && request.resource.data.status == 'pending'
        && request.resource.data.note.size() <= 400
        && roleOf(request.resource.data.fromUid) != roleOf(request.resource.data.toUid);
      // Only the recipient answers a pending request.
      allow update: if signedIn()
        && resource.data.toUid == request.auth.uid
        && resource.data.status == 'pending'
        && request.resource.data.status in ['accepted', 'declined']
        && onlyChanges(['status', 'updatedAt']);
      allow delete: if signedIn() && request.auth.uid in resource.data.participants;
    }

    // A creator + brand pair that are connected, working on one affiliate code.
    match /partnerships/{id} {
      allow read: if signedIn() && request.auth.uid in resource.data.participants;
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.auth.uid in [request.resource.data.creatorUid, request.resource.data.brandUid]
        && request.resource.data.participants == pairId(request.resource.data.creatorUid, request.resource.data.brandUid).split('_')
        && roleOf(request.resource.data.creatorUid) == 'creator'
        && roleOf(request.resource.data.brandUid) == 'brand'
        && connected(request.resource.data.creatorUid, request.resource.data.brandUid)
        && request.resource.data.status == 'active'
        && request.resource.data.code.matches('^[A-Z0-9_-]{2,24}$')
        && request.resource.data.title.size() <= 80;
      allow update: if signedIn()
        && request.auth.uid in resource.data.participants
        && request.resource.data.status in ['active', 'ended']
        && onlyChanges(['status']);
    }

    // Manually logged sales for a partnership; both participants see every entry.
    match /results/{id} {
      allow read: if signedIn() && request.auth.uid in resource.data.participants;
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.auth.uid in request.resource.data.participants
        && get(/databases/$(database)/documents/partnerships/$(request.resource.data.partnershipId)).data.participants == request.resource.data.participants
        && get(/databases/$(database)/documents/partnerships/$(request.resource.data.partnershipId)).data.status == 'active'
        && nonNegative(request.resource.data.sales)
        && nonNegative(request.resource.data.revenue)
        && nonNegative(request.resource.data.earnings)
        && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
      allow delete: if signedIn() && resource.data.createdBy == request.auth.uid;
    }
  }
}
